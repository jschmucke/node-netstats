# ============================================================
# eth-netstats environment variables — copy to .env and fill
# ============================================================

# Shared secret between agent(s) and API server
# Use | to separate multiple accepted secrets
WS_SECRET=change-me-in-production

# API server
PORT=3000
NODE_ENV=production

# CORS — comma-separated list of allowed origins (or * for dev)
ALLOWED_ORIGINS=http://localhost:8080

# Trusted IPs (comma-separated) — these nodes can update history
# Default includes loopback; add your trusted node IPs here
TRUSTED_IPS=::ffff:127.0.0.1,127.0.0.1

# Banned IPs (comma-separated) — these IPs cannot connect
BANNED_IPS=

# Network configuration
# Leave NETWORK_CHAIN_ID unset to use Ethereum mainnet (chain 1)
NETWORK_CHAIN_ID=1
# For custom/private networks, also set:
# NETWORK_NAME=My Network
# NETWORK_SHORT_NAME=MYNET
# NETWORK_NATIVE_SYMBOL=ETH
# NETWORK_EXPECTED_BLOCK_TIME=12000   # milliseconds
# NETWORK_CONSENSUS=pos               # pow | pos | poa
# NETWORK_EXPLORER_URL=https://etherscan.io
# NETWORK_MAX_PROPAGATION_MS=10000

# Agent configuration
# RPC_URL toma prioridad si está definido (soporta wss://, ws://, https://, http://)
RPC_URL=wss://rpc-read.cyberllia.io
# Si no usás RPC_URL, podés usar RPC_HOST + RPC_PORT:
# RPC_HOST=localhost
# RPC_PORT=8545
WS_SERVER=http://localhost:3000
INSTANCE_NAME=my-node
CONTACT_DETAILS=
LISTENING_PORT=30303
VERBOSITY=2
